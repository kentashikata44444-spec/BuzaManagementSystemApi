{
  "openapi": "3.1.1",
  "info": {
    "title": "BuzaiManagementApi | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://0.0.0.0:8080"
    }
  ],
  "paths": {
    "/weatherforecast": {
      "get": {
        "tags": [
          "BuzaiManagementApi"
        ],
        "operationId": "GetWeatherForecast",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/WeatherForecast"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/Common/login/{userCd}": {
      "delete": {
        "tags": [
          "Common"
        ],
        "parameters": [
          {
            "name": "userCd",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/products/sqlserver-text/{id}": {
      "get": {
        "tags": [
          "Products"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/SKL0001G01/conditions": {
      "get": {
        "tags": [
          "SKL0001G01"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/SKL0001G01/login": {
      "post": {
        "tags": [
          "SKL0001G01"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SKL0001G01LoginRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/SKL0001G01LoginRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/SKL0001G01LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SKL0001G01LoginRequest": {
        "type": "object",
        "properties": {
          "userCd": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "userName": {
            "type": "string"
          },
          "bushoCd": {
            "type": "string"
          },
          "bushoName": {
            "type": "string"
          }
        }
      },
      "WeatherForecast": {
        "required": [
          "date",
          "temperatureC",
          "summary"
        ],
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "temperatureC": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "summary": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "BuzaiManagementApi"
    },
    {
      "name": "Common"
    },
    {
      "name": "Products"
    },
    {
      "name": "SKL0001G01"
    }
  ]
}